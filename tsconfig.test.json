{
    "extends": "./tsconfig.node.json",
    "compilerOptions": {
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
        "noUnusedLocals": false,
        "noUnusedParameters": false,
        "lib": ["ES2024", "DOM"],
        "types": ["node", "vitest/globals"],
        "paths": {
            "@/main/*": ["./src/main/*"],
            "@/renderer/*": ["./src/renderer/*"],
            "@/schemas/*": ["./src/schemas/*"],
            "@/preload/*": ["./src/preload/*"]
        }
    },
    "include": ["tests/**/*.ts", "src/**/*.d.ts"]
}
